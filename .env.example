# Copy to .env.local for `npm run dev`. Never commit .env.local (.gitignore covers .env*).
# Every variable is explained in docs/DEPLOY.md.

# Auth.js: `npx auth secret` generates one.
AUTH_SECRET=
# Google OAuth client of type "Web application", with
# http://localhost:3000/api/auth/callback/google among its authorized redirect URIs.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel KV (or any Upstash Redis REST endpoint). Vercel fills these in when a store is attached.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Daily reminders cron (/api/cron/reminders). Vercel sends it as a Bearer token.
CRON_SECRET=

# Web Push: `npx web-push generate-vapid-keys`.
VAPID_EMAIL=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# "Plan with Dot": any OpenAI-compatible chat API. Leave the key empty to offer only the
# copy-and-paste planner.
PLANNER_API_KEY=
# PLANNER_BASE_URL=https://api.groq.com/openai/v1
# PLANNER_MODEL=openai/gpt-oss-120b

# Optional: the one account allowed to open /dev in production.
# LEGACY_OWNER_EMAIL=
